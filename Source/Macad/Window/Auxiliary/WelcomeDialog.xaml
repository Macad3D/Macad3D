<Window x:Class="Macad.Window.WelcomeDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mmp="clr-namespace:Macad.Presentation;assembly=Macad.Presentation"
                     xmlns:mmw="clr-namespace:Macad.Window"
                     mc:Ignorable="d" 
                     Width="500" Height="450"
                     WindowStartupLocation="CenterScreen"
                     ResizeMode="NoResize"
                     Background="{StaticResource Macad.Brushes.Popup.Background}"
                     BorderBrush="{StaticResource Macad.Brushes.Popup.Border}" 
                     BorderThickness="1"
                     Title="Welcome to Macad|3D" 
                     ShowInTaskbar="False" 
                     Icon="/Macad.Resources;component/Controls/SplashScreen/SplashScreen96.png"
                     AutomationProperties.AutomationId="WelcomeDialog">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <mmp:Behaviors.Behavior>
        <mmp:KeyInputBindingBehaviour Key="Escape" Command="{Binding BackCommand}" />
    </mmp:Behaviors.Behavior>

    <Grid Margin="20,10">

    <!-- Start Page -->
    <Grid Visibility="{Binding IsGalleryVisible, Converter={mmp:BoolToInvisibleCollapsedConverter}}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
       
        <DockPanel Grid.Row="0">
            <Image DockPanel.Dock="Right" 
                   Source="{mmp:IconResource App-MainLogo}"
                   Height="64" Width="64"/>
            <StackPanel>
                <TextBlock Text="Welcome to Macad|3D." 
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Macad.Brushes.Text}" />
                <TextBlock Text="Where do you want to start?" 
                           Margin="20,10,10,10"
                           FontSize="14"
                           Foreground="{StaticResource Macad.Brushes.Text}" />
            </StackPanel>
        </DockPanel>

        <Rectangle Grid.Row="1" 
                   Height="1" 
                   Margin="0,10" 
                   Fill="{StaticResource Macad.Brushes.Popup.Header.Border}" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Command="{Binding CreateNewCommand}" 
                    AutomationProperties.AutomationId="CreateNewButton"
                    Height="80" Width="90"
                    Margin="10">
                <StackPanel>
                    <Image Source="{mmp:IconResource App-NewModel}" Width="32" Height="32" />
                    <TextBlock Margin="0,5,0,0">Create New</TextBlock>
                </StackPanel>
            </Button>
            <Button Command="{Binding OpenExistingCommand}"
                    AutomationProperties.AutomationId="OpenExistingButton"
                    Height="80" Width="90"
                    Margin="10">
                <StackPanel>
                    <Image Source="{mmp:IconResource App-OpenModel}" Width="32" Height="32" />
                    <TextBlock Margin="0,5,0,0">Open Existing</TextBlock>
                </StackPanel>
            </Button>
            <Button Command="{Binding OpenSampleCommand}"
                    x:Name="OpenSampleButton"
                    AutomationProperties.AutomationId="OpenSampleButton"
                    Height="80" Width="90"
                    Margin="10">
                <StackPanel>
                    <Image Source="{mmp:IconResource App-OpenSample}" Width="32" Height="32" />
                    <TextBlock Margin="0,5,0,0">Open Sample</TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>

        <Rectangle Grid.Row="3"
                   Height="1" 
                   Margin="0,10" 
                   Fill="{StaticResource Macad.Brushes.Popup.Header.Border}" />

        <TextBlock Grid.Row="4" 
                   Text="Open Recent Model:"
                   Margin="10,5"
                   FontSize="14"
                   Foreground="{StaticResource Macad.Brushes.Text}" />

        <ListBox Grid.Row="5" 
                 AutomationProperties.AutomationId="RecentList"
                 ItemsSource="{Binding MruList}">
            <mmp:Behaviors.Behavior>
                <mmp:ItemActivationCommandBehaviour Command="{Binding OpenRecentCommand}"/>
            </mmp:Behaviors.Behavior>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel ToolTipService.InitialShowDelay="100">
                        <DockPanel.ToolTip>
                            <ToolTip Placement="Right"
                                     HorizontalOffset="-80" VerticalOffset="-5"
                                     DataContext="{Binding PlacementTarget.DataContext, Converter={mmp:ExtractFileThumbnailConverter}, RelativeSource={RelativeSource Self}}"
                                     Visibility="{Binding Converter={mmp:NotNullToVisibleCollapsedConverter}}">
                                <Image Source="{Binding}" 
                                       MaxWidth="128" MaxHeight="128" 
                                       RenderOptions.BitmapScalingMode="Fant" />
                            </ToolTip>
                        </DockPanel.ToolTip>

                        <Image DockPanel.Dock="Left"
                               Source="{mmp:IconResource App-OpenRecent}" 
                               Height="20" Width="20"
                               Margin="0,0,10,0"/>

                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding Converter={mmp:ExtractFileNameNoExtensionConverter}}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock DockPanel.Dock="Top"
                                   FontSize="10"
                                   Foreground="{StaticResource Macad.Brushes.TextLight}"
                                   MaxWidth="400">
                            <mmp:Behaviors.Behavior>
                                <mmp:PathEllipsisTextBehaviour OriginalPath="{Binding Converter={mmp:ExtractFileDirectoryConverter}}" />
                            </mmp:Behaviors.Behavior>
                        </TextBlock>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>

    <!-- Sample Gallery Page -->
    <Grid Visibility="{Binding IsGalleryVisible, Converter={mmp:BoolToVisibleCollapsedConverter}}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Left"
                    Command="{Binding BackCommand}"
                    AutomationProperties.AutomationId="SamplesBackButton"
                    AutomationProperties.Name="Back"
                    ToolTip="Back to start page"
                    Style="{mmp:AppResource Macad.Styles.Button.Glyph}"
                    Content="{mmp:AppResource Macad.Geometries.Back}"
                    Padding="4,2,4,0" />
            
            <TextBlock Text="Open a Sample"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Macad.Brushes.Text}" />
        </DockPanel>

        <Rectangle Grid.Row="1"
                   Height="1"
                   Margin="0,10"
                   Fill="{StaticResource Macad.Brushes.Popup.Header.Border}" />

        <ListBox Grid.Row="2"
                 x:Name="SampleList"
                 AutomationProperties.AutomationId="SampleList"
                 ItemsSource="{Binding Samples}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
            <mmp:Behaviors.Behavior>
                <mmp:ItemActivationCommandBehaviour Command="{Binding OpenSampleFileCommand}"/>
            </mmp:Behaviors.Behavior>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type mmw:SampleInfo}">
                    <DockPanel Margin="0,4"
                               ToolTip="{Binding Description}"
                               ToolTipService.IsEnabled="{Binding Description, Converter={mmp:StringNotEmptyToBoolConverter}}">
                        <Grid DockPanel.Dock="Left"
                              Width="96" Height="96"
                              Margin="0,0,10,0">
                            <Image Source="{Binding Thumbnail}"
                                   RenderOptions.BitmapScalingMode="Fant" />
                            <!-- Placeholder for samples without thumbnail -->
                            <Image Source="{mmp:IconResource App-OpenSample}"
                                   Width="48" Height="48">
                                <Image.Visibility>
                                    <MultiBinding Converter="{mmp:BooleanAndToVisibleCollapsedMultiConverter}">
                                        <Binding Path="IsThumbnailLoaded" />
                                        <Binding Path="Thumbnail" Converter="{mmp:NotNullToNotBoolConverter}" />
                                    </MultiBinding>
                                </Image.Visibility>
                            </Image>
                        </Grid>

                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding Description}"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource Macad.Brushes.TextLight}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   LineHeight="16"
                                   LineStackingStrategy="BlockLineHeight"
                                   MaxHeight="48"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>

    </Grid>
</Window>
